{
    "name": "aether",
    "private": true,
    "license": "MIT",
    "type": "module",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "dev": "npm run dev -w @aether/site",
        "build": "npm run build -w @aether/site",
        "build:lib": "npm run build -w aether-physics",
        "preview": "npm run preview -w @aether/site",
        "typecheck": "npm run typecheck --workspaces",
        "test": "vitest",
        "test:run": "vitest run",
        "test:smoke": "npm run test:smoke -w @aether/editor --",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "dev:editor": "npm run dev -w @aether/editor",
        "build:editor": "npm run build -w @aether/editor",
        "start": "npm run start -w @aether/site"
    },
    "devEngines": {},
    "devDependencies": {
        "prettier": "3.9.10",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    }
}
