---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import InstallLine from "../components/InstallLine.astro";
import { REPOSITORY_URL, href } from "../site";

const demo = (id: string) => href(`/demos/#/${id}`);

const today = [
    { id: "orbits", title: "Orbits", line: "Dust circling two stars, every grain pulled by both.", warmup: 2, camera: "", values: "" },
    { id: "fireworks", title: "Fireworks", line: "Hundreds of particles sharing one drag force.", warmup: 2.15, camera: "2,15,32 1,18,0", values: "sparks=360&burst=11" },
    { id: "springs", title: "Springs", line: "An anchor, a pair and a bungee. Grab the block.", warmup: 0.9, camera: "0,5.4,17 0,4.6,0", values: "" },
] as const;

const sample = `import { Particle, ParticleWorld, ParticleAnchoredSpring } from "aether-physics";

const world = new ParticleWorld();
const bob = new Particle();
bob.position.set(1, 4, 0);
world.particles.push(bob);

// 40 N/m, 2 m at rest, hung from (0, 7, 0)
world.forceRegistry.add(bob, new ParticleAnchoredSpring({ x: 0, y: 7, z: 0 }, 40, 2));

function frame() {
    world.step(1 / 60);
    mesh.position.copy(bob.position); // engine vectors are plain x, y, z
    requestAnimationFrame(frame);
}`;
---

<Base
    title="Aether · a 3D physics engine for TypeScript"
    description="Aether is a 3D physics engine for TypeScript, written from scratch with no dependencies. Particles, springs, drag, buoyancy and contacts on a fixed timestep."
>
    <section class="hero" aria-labelledby="hero-title">
        <aether-scene
            id="hero-scene"
            demo="cloth"
            values="wind=7"
            label="A cloth blowing in the wind."
        ></aether-scene>
        <div class="hero-copy">
            <h1 id="hero-title">A 3D physics engine for TypeScript.</h1>
            <p>Written from scratch, with no dependencies. Particles, springs, drag, buoyancy and contacts on a fixed timestep.</p>
            <div class="actions">
                <a class="btn primary" href={href("/demos/")}>
                    Open the demos
                    <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
                </a>
                <InstallLine />
            </div>
        </div>
        <p class="hint">Drag a pin on the cloth</p>
    </section>

    <section class="today" aria-labelledby="today-title">
        <header class="section-head">
            <h2 id="today-title">Live demos</h2>
            <a href={href("/demos/")}>Every demo</a>
        </header>
        <ul class="today-grid">
            {
                today.map((d) => (
                    <li>
                        <a href={demo(d.id)}>
                            <aether-scene demo={d.id} values={d.values} warmup={d.warmup} camera={d.camera} label={`${d.title} demo, running.`} />
                            <span class="name">
                                {d.title}
                                <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M3 8h10M9 4l4 4-4 4" />
                                </svg>
                            </span>
                            <span class="line">{d.line}</span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="code" aria-labelledby="code-title">
        <div class="code-copy">
            <h2 id="code-title">Plain TypeScript, any renderer.</h2>
            <p>
                The engine never touches the DOM. Step a world, copy positions onto whatever draws them:
                Three.js, a canvas, a server.
            </p>
            <ul class="facts">
                <li><b>0</b> dependencies</li>
                <li><b>Fixed</b> timestep, interpolated</li>
                <li><b>Any runtime</b> browser or Node</li>
                <li><b>MIT</b> licensed</li>
            </ul>
            <p class="more">
                <a href={href("/docs/getting-started/")}>Getting started</a>
                &nbsp;<span aria-hidden="true">·</span>&nbsp;
                Every demo's source is one tab away.
            </p>
        </div>
        <div class="code-block">
            <Code code={sample} lang="ts" themes={{ light: "min-light", dark: "min-dark" }} />
        </div>
    </section>

    <section class="close" aria-labelledby="close-title">
        <h2 id="close-title">Pull on something.</h2>
        <div class="actions">
            <a class="btn primary" href={href("/demos/")}>Open the demos</a>
            <a class="btn" href={href("/docs/")}>Read the docs</a>
            <a class="btn" href={REPOSITORY_URL} target="_blank" rel="noopener">Follow on GitHub</a>
        </div>
    </section>
</Base>

<script>
    import "@aether/editor/scene";
    import type { AetherScene } from "@aether/editor/scene";
    const hero = document.getElementById("hero-scene") as AetherScene | null;
    if (hero) {
        // Wide screens leave room on the left for the headline; narrow ones stack the headline
        // above the scene and centre the cloth.
        const frame = () => {
            const narrow = hero.clientWidth < 760;
            hero.setCamera(
                narrow ? { x: 3, y: 5.2, z: 13 } : { x: -2.5, y: 5, z: 14 },
                narrow ? { x: 0, y: 3.6, z: 0.5 } : { x: -4.2, y: 4, z: 0 },
            );
        };
        hero.updateComplete.then(frame);
    }
</script>

<style>
    .hero {
        position: relative;
        height: clamp(520px, calc(100svh - 92px), 900px);
        margin-top: calc(var(--u) * 2.5);
        border-radius: var(--radius);
        overflow: hidden;
    }
    .hero aether-scene {
        position: absolute;
        inset: 0;
    }
    .hero-copy {
        position: absolute;
        top: calc(var(--u) * 5);
        left: calc(var(--u) * 5);
        max-width: min(640px, calc(100% - 80px));
        pointer-events: none;
    }
    .hero-copy .actions {
        pointer-events: auto;
    }
    h1 {
        margin: 0;
        font: 800 clamp(40px, 4.8vw, 68px) / 0.95 var(--sans);
        letter-spacing: -0.04em;
        text-wrap: balance;
    }
    .hero-copy p {
        margin: 20px 0 0;
        max-width: 42ch;
        font-size: var(--text-lead);
        line-height: 1.45;
        color: var(--ink-2);
    }
    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--u) 12px;
        margin-top: calc(var(--u) * 3.5);
    }
    .hint {
        position: absolute;
        left: calc(var(--u) * 5);
        bottom: calc(var(--u) * 3);
        margin: 0;
        font: 400 var(--text-label) / 1 var(--mono);
        color: var(--muted);
        pointer-events: none;
    }

    section + section {
        margin-top: calc(var(--u) * 14);
    }
    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: calc(var(--u) * 2);
        padding-bottom: calc(var(--u) * 2);
        border-bottom: 2px solid var(--rule-strong);
    }
    h2 {
        margin: 0;
        font: 750 clamp(30px, 3.4vw, 48px) / 1 var(--sans);
        letter-spacing: -0.035em;
    }
    .section-head a,
    .more a {
        color: var(--ink);
        font: 600 var(--text-small) / 1 var(--sans);
        text-underline-offset: 4px;
        text-decoration-color: var(--accent);
    }

    .today-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .today-grid li + li {
        border-left: 1px solid var(--rule);
    }
    .today-grid a {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: calc(var(--u) * 3) calc(var(--u) * 3) calc(var(--u) * 3) 0;
        color: inherit;
        text-decoration: none;
    }
    .today-grid li + li a {
        padding-left: calc(var(--u) * 3);
    }
    .today-grid aether-scene {
        height: 280px;
        margin-bottom: calc(var(--u) * 1.5);
        border-radius: var(--radius);
    }
    .today-grid .name {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font: 750 28px / 1 var(--sans);
        letter-spacing: -0.03em;
    }
    .today-grid .name .icon {
        transition: transform 200ms var(--ease-out);
    }
    .today-grid a:hover .name .icon {
        transform: translateX(4px);
        color: var(--accent-ink);
    }
    .today-grid .line {
        font-size: var(--text-small);
        color: var(--ink-2);
    }

    .code {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: calc(var(--u) * 7);
        align-items: start;
        padding-top: calc(var(--u) * 4);
        border-top: 2px solid var(--rule-strong);
    }
    .code-copy p {
        margin: 18px 0 0;
        max-width: 44ch;
        font-size: var(--text-lead);
        line-height: 1.5;
        color: var(--ink-2);
    }
    .facts {
        display: grid;
        grid-template-columns: 1fr 1fr;
        margin: calc(var(--u) * 4) 0 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--rule);
    }
    .facts li {
        padding: 14px 0;
        border-bottom: 1px solid var(--rule);
        font-size: var(--text-small);
        color: var(--ink-2);
    }
    .facts b {
        display: block;
        font: 700 20px / 1.2 var(--sans);
        color: var(--ink);
    }
    .more {
        font-size: var(--text-small) !important;
    }
    .code-block :global(pre) {
        margin: 0;
        padding: calc(var(--u) * 3);
        overflow-x: auto;
        background: var(--paper-sunk) !important;
        border-radius: var(--radius);
        font: 400 14px / 1.7 var(--mono);
    }

    .close {
        padding: calc(var(--u) * 8) 0 calc(var(--u) * 2);
        border-top: 2px solid var(--rule-strong);
    }
    .close h2 {
        font-size: clamp(44px, 6vw, 96px);
        letter-spacing: -0.035em;
    }

    @media (max-width: 1000px) {
        .code {
            grid-template-columns: minmax(0, 1fr);
            gap: calc(var(--u) * 4);
        }
    }
    @media (max-width: 760px) {
        .hero {
            height: auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
            border-radius: 0;
        }
        .hero aether-scene {
            position: relative;
            height: 56svh;
            min-height: 320px;
            order: 2;
        }
        .hero-copy {
            position: static;
            order: 1;
            max-width: none;
            padding: calc(var(--u) * 3) 0;
        }
        .hint {
            display: none;
        }
        .today-grid {
            grid-template-columns: 1fr;
        }
        .today-grid li + li {
            border-left: 0;
            border-top: 1px solid var(--rule);
        }
        .today-grid li + li a,
        .today-grid a {
            padding-left: 0;
            padding-right: 0;
        }
        .today-grid aether-scene {
            height: 220px;
        }
    }
</style>
