---
const command = "npm install aether-physics";
---

<button class="install" type="button" data-command={command} aria-label={`Copy: ${command}`}>
    <span class="prompt" aria-hidden="true">$</span>
    <span class="cmd">{command}</span>
    <span class="state" aria-live="polite">Copy</span>
</button>

<script>
    for (const button of document.querySelectorAll<HTMLButtonElement>("button.install")) {
        const state = button.querySelector(".state");
        button.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText(button.dataset.command ?? "");
                if (state) state.textContent = "Copied";
            } catch {
                if (state) state.textContent = "Select and copy";
            }
            setTimeout(() => {
                if (state) state.textContent = "Copy";
            }, 1800);
        });
    }
</script>

<style>
    .install {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-height: 44px;
        padding: 0 14px;
        border: 1px solid var(--rule-strong);
        border-radius: var(--radius);
        background: color-mix(in srgb, var(--paper) 80%, transparent);
        color: var(--ink);
        font: 500 14px / 1 var(--mono);
        cursor: pointer;
        user-select: all;
        transition: background-color 160ms var(--ease-out);
    }
    .install:hover {
        background: var(--paper);
    }
    .prompt {
        color: var(--muted);
    }
    .state {
        padding-left: 12px;
        border-left: 1px solid var(--rule);
        font: 600 var(--text-small) / 1 var(--sans);
        color: var(--muted);
    }
</style>
