---
/** The Aether wordmark: the strut mark stands in for the A. Sized by the surrounding font size. */
---

<span class="wordmark" role="img" aria-label="Aether"
    ><svg viewBox="6.5 2.6 19 25.4" aria-hidden="true"
        ><path d="M8.2 28 16 9.6 23.8 28" stroke-width="3.6" stroke-linejoin="round"></path><path
            d="M11.2 20.6Q16 24.8 20.8 20.6"
            stroke-width="2.4"
            stroke-linecap="round"></path><circle cx="16" cy="7" r="4.4"></circle></svg
    >ether</span
>

<style>
    .wordmark {
        display: inline-flex;
        align-items: baseline;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.03em;
    }
    svg {
        width: 0.733em;
        height: 0.98em;
        margin-right: 0.03em;
        overflow: visible;
    }
    path {
        fill: none;
        stroke: currentColor;
    }
    circle {
        fill: var(--accent);
    }
</style>
