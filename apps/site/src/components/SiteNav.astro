---
import { ENGINE_VERSION, REPOSITORY_URL, href } from "../site";

interface Props {
    section: "home" | "demos" | "docs";
}

const { section } = Astro.props;
const links = [
    { id: "demos", label: "Demos", url: href("/demos/") },
    { id: "docs", label: "Docs", url: href("/docs/") },
    { id: "roadmap", label: "Roadmap", url: href("/#roadmap") },
] as const;
---

<header class="site-nav">
    <a class="mark" href={href("/")} aria-label="Aether home"><b>Aether</b></a>
    <nav aria-label="Site">
        {
            links.map((link) => (
                <a href={link.url} aria-current={link.id === section ? "page" : undefined}>
                    {link.label}
                </a>
            ))
        }
    </nav>
    <div class="end">
        <a href={REPOSITORY_URL} target="_blank" rel="noopener" aria-label="Aether on GitHub">
            <span class="github-label">GitHub</span>
            <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M9.5 3h3.5v3.5M13 3 7.5 8.5M11.5 9.5V13H3V4.5h3.5"></path>
            </svg>
        </a>
        <span class="version">aether-physics {ENGINE_VERSION}</span>
    </div>
</header>

<style>
    .site-nav {
        display: flex;
        align-items: center;
        gap: calc(var(--u) * 4);
        min-height: 60px;
        margin: 0 var(--gutter);
        border-bottom: 1px solid var(--rule-strong);
    }
    .mark {
        color: inherit;
        text-decoration: none;
    }
    .mark b {
        font: 800 22px / 1 var(--sans);
        letter-spacing: -0.03em;
    }
    nav {
        display: flex;
        gap: calc(var(--u) * 3);
    }
    nav a {
        position: relative;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: var(--muted);
        font: 600 var(--text-body) / 1 var(--sans);
        text-decoration: none;
        transition: color 160ms var(--ease-out);
    }
    nav a:hover,
    nav a[aria-current] {
        color: var(--ink);
    }
    nav a[aria-current]::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 4px;
        height: 2px;
        background: var(--accent);
    }
    .end {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: calc(var(--u) * 3);
    }
    .end a {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--ink);
        font: 600 var(--text-small) / 1 var(--sans);
        text-decoration: none;
    }
    .end a:hover {
        color: var(--accent-ink);
    }
    .version {
        font: 400 var(--text-label) / 1 var(--mono);
        color: var(--muted);
    }
    @media (max-width: 720px) {
        .site-nav {
            gap: calc(var(--u) * 2.5);
        }
        .version,
        .github-label {
            display: none;
        }
    }
</style>
