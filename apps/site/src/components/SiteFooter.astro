---
import { ENGINE_VERSION, REPOSITORY_URL, href } from "../site";
---

<footer class="site-footer">
    <div class="cols">
        <div>
            <b>Aether</b>
            <p>A 3D rigid-body physics engine for TypeScript, written from scratch.</p>
        </div>
        <nav aria-label="Footer">
            <a href={href("/demos/")}>Demos</a>
            <a href={href("/docs/")}>Docs</a>
            <a href={href("/#roadmap")}>Roadmap</a>
            <a href={REPOSITORY_URL} target="_blank" rel="noopener">GitHub</a>
            <a href="https://www.npmjs.com/package/aether-physics" target="_blank" rel="noopener">npm</a>
        </nav>
    </div>
    <p class="fine">aether-physics {ENGINE_VERSION} · MIT licensed</p>
</footer>

<style>
    .site-footer {
        margin: calc(var(--u) * 10) var(--gutter) 0;
        padding: calc(var(--u) * 4) 0;
        border-top: 1px solid var(--rule-strong);
    }
    .cols {
        display: flex;
        justify-content: space-between;
        gap: calc(var(--u) * 4);
        flex-wrap: wrap;
    }
    b {
        font: 800 18px / 1 var(--sans);
        letter-spacing: -0.03em;
    }
    p {
        margin: 8px 0 0;
        max-width: 40ch;
        color: var(--ink-2);
        font-size: var(--text-small);
    }
    nav {
        display: flex;
        flex-wrap: wrap;
        gap: var(--u) calc(var(--u) * 3);
    }
    nav a {
        color: var(--ink);
        font: 600 var(--text-small) / 1.4 var(--sans);
        text-decoration: underline;
        text-decoration-color: var(--rule);
        text-underline-offset: 4px;
    }
    nav a:hover {
        text-decoration-color: var(--accent);
    }
    .fine {
        margin-top: calc(var(--u) * 4);
        font: 400 var(--text-label) / 1 var(--mono);
        color: var(--muted);
    }
</style>
